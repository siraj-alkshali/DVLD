{
  "ConnectionStrings": {
    "DVLDConnection": "server=localhost;database=DVLD;user=root;password=YOUR_PASSWORD"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "your-secret-key",
    "Issuer": "DVLD.API",
    "Audience": "DVLD.Client",
    "DurationInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["https://dvld.example.com"]
  },
  "AllowedHosts": "*"
}
